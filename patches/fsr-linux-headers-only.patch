diff --git a/src/ui/CMakeLists.txt b/src/ui/CMakeLists.txt
index 5bd3dc5..809377a 100644
--- a/src/ui/CMakeLists.txt
+++ b/src/ui/CMakeLists.txt
@@ -125,6 +125,11 @@ if(REXGLUE_FIDELITYFX_SOURCE_DIR AND EXISTS "${REXGLUE_FIDELITYFX_SOURCE_DIR}/sd
 endif()
 
 set(REXUI_HAS_FIDELITYFX_RUNTIME OFF)
+# The FidelityFX runtime (FSR2/FSR3) requires its Windows shader compiler
+# (FidelityFX_SC.exe) to generate shader permutations, which cannot run on
+# Linux without Wine. FSR 1.0 (EASU/RCAS) uses precompiled SPIR-V and only
+# needs the SDK headers, so skip the runtime link on non-Windows.
+if(WIN32)
 if(TARGET amd_fidelityfx_vk)
     target_link_libraries(rexui PRIVATE amd_fidelityfx_vk)
     set(REXUI_HAS_FIDELITYFX_RUNTIME ON)
@@ -133,6 +138,7 @@ if(TARGET amd_fidelityfx_dx12)
     target_link_libraries(rexui PRIVATE amd_fidelityfx_dx12)
     set(REXUI_HAS_FIDELITYFX_RUNTIME ON)
 endif()
+endif()
 if(REXUI_HAS_FIDELITYFX_RUNTIME)
     target_compile_definitions(rexui PRIVATE REX_HAS_FIDELITYFX_RUNTIME=1)
 endif()
